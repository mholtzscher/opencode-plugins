{
  "name": "@mholtzscher/opencode-cache-metrics",
  "version": "1.0.0",
  "description": "OpenCode V2 plugin for input cache-hit rates, token totals, response history, and JSON export in the TUI",
  "keywords": [
    "cache",
    "opencode",
    "opencode-plugin",
    "tokens"
  ],
  "homepage": "https://github.com/mholtzscher/opencode-plugins/tree/main/cache-metrics#readme",
  "bugs": {
    "url": "https://github.com/mholtzscher/opencode-plugins/issues"
  },
  "license": "MIT",
  "author": "Michael Holtzscher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mholtzscher/opencode-plugins.git",
    "directory": "cache-metrics"
  },
  "files": [
    "index.ts",
    "dist/tui.js",
    "cache-rate.ts",
    "cache-history.ts",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tui": "./dist/tui.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:tui": "bun run build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.18"
  },
  "devDependencies": {
    "@opentui/solid": "0.5.12",
    "@types/bun": "latest",
    "@types/node": "latest",
    "solid-js": "1.9.12",
    "typescript": "latest"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  }
}
