{
  "name": "@mholtzscher/opencode-classify",
  "version": "1.5.1",
  "description": "OpenCode V2 plugin for typed classification with file, diff, and Tree-sitter code evidence",
  "keywords": [
    "classification",
    "opencode",
    "opencode-plugin",
    "tree-sitter"
  ],
  "homepage": "https://github.com/mholtzscher/opencode-plugins/tree/main/classify#readme",
  "bugs": {
    "url": "https://github.com/mholtzscher/opencode-plugins/issues"
  },
  "license": "MIT",
  "author": "Michael Holtzscher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mholtzscher/opencode-plugins.git",
    "directory": "classify"
  },
  "files": [
    "*.ts",
    "*.tsx",
    "docs/",
    "grammars/",
    "protocols/",
    "providers/",
    "skills/",
    "validation/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./output": "./output.ts",
    "./rpc": "./rpc.ts",
    "./types": "./types.ts",
    "./tui": "./tui.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@opencode/plugin": "2.0.21",
    "@opencode/schema": "2.0.21",
    "effect": "4.0.0-rc.112",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  }
}
