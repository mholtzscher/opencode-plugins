{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "agents": {
    "build": { "model": "openai/gpt-6.1-sol" },
  },
  "plugins": [
    "./marketplace",
    "./cache-metrics",
    "./quota-usage",
    "./workflow-tools",
    {
      "package": "./classify",
      "options": {
        "defaultBackend": "openai-gpt-6-luna",
        "backends": {
          "openai-gpt-6-luna": {
            "provider": "openai-decisions",
            "model": "gpt-6-luna",
            "apiKeyFile": "/home/michael/.local/share/agenix/hearth-openai-api-key",
          },
          "ollama-nimble": {
            "provider": "ollama",
            "baseURL": "http://127.0.0.1:11434",
            "model": "nimble",
          },
          "ollama-clef-flash": {
            "provider": "ollama",
            "baseURL": "http://127.0.0.1:11434",
            "model": "clef-flash",
          },
          "cloudflare-clef": {
            "provider": "cloudflare",
            "accountID": "f3ccf566c685532060346747f4610aa6",
            "apiKeyFile": "/home/michael/.local/share/agenix/cloudflare-workers-ai-key",
          },
          "cloudflare-clef-flash": {
            "provider": "cloudflare",
            "accountID": "f3ccf566c685532060346747f4610aa6",
            "apiKeyFile": "/home/michael/.local/share/agenix/cloudflare-workers-ai-key",
            "model": "clef-flash",
          },
          "typesafe-jev-latest": {
            "provider": "typesafe",
            "apiKeyFile": "~/.local/share/agenix/typesafe-api-key",
          },
        },
        "timeoutMs": 120000,
        "maxRetries": 0,
      },
    },
  ],
  "experimental": {
    "policies": [
      // Exclude installed sources here so the local copies can use the same IDs.
      {
        "action": "integration.use",
        "resource": "plugin:github:mholtzscher/opencode-plugins#main::path:cache-metrics",
        "effect": "deny",
      },
      {
        "action": "integration.use",
        "resource": "plugin:github:mholtzscher/opencode-plugins#main::path:quota-usage",
        "effect": "deny",
      },
      {
        "action": "integration.use",
        "resource": "plugin:github:mholtzscher/opencode-plugins#main::path:workflow-tools",
        "effect": "deny",
      },
      {
        "action": "integration.use",
        "resource": "plugin:@mholtzscher/opencode-classify",
        "effect": "deny",
      },
    ],
  },
}
