{
  "name": "@mholtzscher/opencode-workflow-tools",
  "version": "2.0.0",
  "description": "OpenCode V2 server plugin for specification and pull-request workflows",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pull-request",
    "specification",
    "workflow"
  ],
  "homepage": "https://github.com/mholtzscher/opencode-plugins/tree/main/workflow-tools#readme",
  "bugs": {
    "url": "https://github.com/mholtzscher/opencode-plugins/issues"
  },
  "license": "MIT",
  "author": "Michael Holtzscher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mholtzscher/opencode-plugins.git",
    "directory": "workflow-tools"
  },
  "files": [
    "*.ts",
    "!*.test.ts",
    "pr/**/*.ts",
    "!pr/**/*.test.ts",
    "specs/**/*.ts",
    "!specs/**/*.test.ts",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@opencode/plugin": "^2.0.22",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112"
  }
}
