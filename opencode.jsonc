{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "./marketplace",
    "./cache-metrics",
    "./quota-usage",
    "./github-tools",
    "./spec-tools",
    {
      "package": "./classify",
      "options": {
        "backend": {
          "provider": "typesafe",
          "apiKeyFile": "~/.local/share/agenix/typesafe-api-key",
        },
      },
    },
  ],
}
